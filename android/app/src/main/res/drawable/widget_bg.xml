<?xml version="1.0" encoding="utf-8"?>
<!-- 小部件背景：圆角 + 渐变。用 color 引用，自动适配深色模式。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_corner_radius" />
    <gradient
        android:startColor="@color/widget_bg_start"
        android:endColor="@color/widget_bg_end"
        android:angle="270" />
    <stroke
        android:width="0.5dp"
        android:color="@color/widget_stroke" />
</shape>